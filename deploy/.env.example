# Copy to deploy/.env on the server. Read by docker-compose.prod.yml and by the
# systemd unit. Contains no secrets — every value here is public.

# The hostname the certificate is issued for and the app connects to.
# With no domain yet, sslip.io resolves any dotted-or-dashed IP to itself, and
# Let's Encrypt will issue for it: 203.0.113.7 -> 203-0-113-7.sslip.io
APP_HOSTNAME=203-0-113-7.sslip.io

# Where Let's Encrypt sends expiry warnings. Only used at first issuance.
LETSENCRYPT_EMAIL=you@example.com

# The Firebase project whose ID tokens are accepted. Must match the app's.
FIREBASE_PROJECT_ID=signinpractice-bfade
