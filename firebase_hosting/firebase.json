{
  "hosting": [
    {
      "site": "void-factor",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/node_modules/**",
        "**/.DS_Store"
      ],
      "headers": [
        {
          "source": "/.well-known/assetlinks.json",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=300"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "cleanUrls": true
    },
    {
      "site": "signinpractice-bfade",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/node_modules/**",
        "**/.DS_Store"
      ],
      "headers": [
        {
          "source": "/.well-known/assetlinks.json",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=300"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "cleanUrls": true
    }
  ]
}
