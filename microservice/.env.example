# Copy to .env and fill in. Never commit the filled copy.

# ── Required in production ────────────────────────────────────────────────────
# The Firebase project whose ID tokens this service accepts. Not a secret; it
# already ships inside the Flutter binary. When unset, every /api/ route returns
# 503 rather than accepting unverified callers.
FIREBASE_PROJECT_ID=signinpractice-bfade

# ── Optional: development fallback keys ───────────────────────────────────────
# Users normally supply their own provider key per request (X-Gemini-Key,
# X-OpenRouter-Key, X-Nvidia-Key). These are only used when the request carries
# no key, which is a convenience for local testing. Leave blank in production so
# an unkeyed request fails instead of spending your quota.
x_gemini_key=
x_openrouter_key=
NVIDIA_API_KEY=

# Overrides the default OpenRouter vision model.
OPENROUTER_MODEL=google/gemini-2.0-flash-001
